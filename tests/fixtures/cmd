#!/usr/bin/env node
// Test stub for the Command Code CLI (`cmd`). Never calls a model.
//
// Env contract:
//   CMD_STUB_RECORD   path of a JSON file receiving { argv, env, pid, cwd }
//   CMD_STUB_SCENARIO path of a JSON scenario:
//     {
//       "script": [
//         { "emit": { ...any JSON value... } },   // printed as one NDJSON line
//         { "raw": "<base64 bytes>" },            // written verbatim (chunk splits)
//         { "stderr": "text" },                   // written to stderr
//         { "hang": true }                        // then wait until killed
//       ],
//       "stderr": "text",        // written to stderr before exiting
//       "exitCode": 0,           // process exit code (default 0)
//       "ignoreSigterm": false   // swallow SIGTERM (forces SIGKILL escalation)
//     }
"use strict";
const fs = require("node:fs");

const argv = process.argv.slice(2);
const recordPath = process.env.CMD_STUB_RECORD;
const scenarioPath = process.env.CMD_STUB_SCENARIO;

if (recordPath) {
  fs.writeFileSync(
    recordPath,
    JSON.stringify({ argv, env: process.env, pid: process.pid, cwd: process.cwd() }, null, 2),
  );
}

let scenario = {};
if (scenarioPath) {
  try {
    scenario = JSON.parse(fs.readFileSync(scenarioPath, "utf8"));
  } catch {
    scenario = {};
  }
}

if (scenario.ignoreSigterm) {
  process.on("SIGTERM", () => {});
}

const script = Array.isArray(scenario.script) ? scenario.script : [];
let hang = false;
for (const step of script) {
  if (!step || typeof step !== "object") continue;
  if ("emit" in step) {
    process.stdout.write(JSON.stringify(step.emit) + "\n");
  } else if ("raw" in step) {
    process.stdout.write(Buffer.from(step.raw, "base64"));
  } else if ("stderr" in step) {
    process.stderr.write(String(step.stderr));
  } else if (step.hang) {
    hang = true;
  }
}

if (hang) {
  setInterval(() => {}, 1000);
} else {
  if (typeof scenario.stderr === "string") {
    process.stderr.write(scenario.stderr);
  }
  process.exit(typeof scenario.exitCode === "number" ? scenario.exitCode : 0);
}
