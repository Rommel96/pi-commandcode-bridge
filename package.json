    "pi-package",
    "pi-extension",
    "pi-provider",
    "commandcode",
    "command-code",
    "cmd",
    "mcp",
    "subagents"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Rommel96 (https://github.com/Rommel96)",
  "homepage": "https://github.com/Rommel96/pi-commandcode-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rommel96/pi-commandcode-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Rommel96/pi-commandcode-bridge/issues"
  },
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "bun test"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
